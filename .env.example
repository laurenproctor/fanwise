# Copy to .env.local and fill in. Validated by lib/env.ts at boot.
# Anything missing or malformed fails fast rather than at runtime.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser, never log, never put in an AI prompt.
SUPABASE_SERVICE_ROLE_KEY=

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Observability (optional until step A5) ---------------------------------
SENTRY_DSN=

# --- Credential encryption (used from step A5, Shopify) ---------------------
# 32-byte key, base64 encoded. Generate: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# --- Added in later steps, keep here so the shape is known ------------------
# ANTHROPIC_API_KEY=            # step B1
# STRIPE_SECRET_KEY=            # step C1
# STRIPE_WEBHOOK_SECRET=        # step C1
# SHOPIFY_CLIENT_ID=            # step A5
# SHOPIFY_CLIENT_SECRET=        # step A5
# ETSY_CLIENT_ID=               # step A6
# ETSY_CLIENT_SECRET=           # step A6
